# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/spirits-wiki?sslmode=require

# NextAuth
NEXTAUTH_SECRET=generate-a-random-32-char-string-here
NEXTAUTH_URL=http://localhost:3000

# Wiki access password
WIKI_PASSWORD=your-secret-password

# LLM Provider: "groq" (cloud, rate-limited) or "ollama" (local, no rate limits)
LLM_PROVIDER=ollama

# Groq settings (only needed if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_xxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# Vercel Blob (for image storage in production — not needed for local dev)
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxx
